{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EML Systems public engagement and pricing catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "page", "groups", "commercialNotes", "offers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "description", "headline", "emphasis", "intro"],
      "properties": {
        "title": { "$ref": "#/$defs/text" }, "description": { "$ref": "#/$defs/text" },
        "headline": { "$ref": "#/$defs/text" }, "emphasis": { "$ref": "#/$defs/text" }, "intro": { "$ref": "#/$defs/text" }
      }
    },
    "groups": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "description"],
        "properties": { "id": { "$ref": "#/$defs/slug" }, "title": { "$ref": "#/$defs/text" }, "description": { "$ref": "#/$defs/text" } }
      }
    },
    "commercialNotes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "text"],
        "properties": { "title": { "$ref": "#/$defs/text" }, "text": { "$ref": "#/$defs/text" } }
      }
    },
    "offers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/offer" } }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "texts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "money": { "type": ["number", "null"], "minimum": 0, "description": "Amount in currency major units. Use null when no number is offered. Runtime validation checks currency precision." },
    "price": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "currency", "amount", "minimum", "maximum", "unit", "note"],
      "properties": {
        "model": { "enum": ["quote", "fixed", "from", "range", "indicative"] },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$", "description": "Supported currency code for numeric prices; null for quotes." },
        "amount": { "$ref": "#/$defs/money" }, "minimum": { "$ref": "#/$defs/money" }, "maximum": { "$ref": "#/$defs/money" },
        "unit": { "enum": ["engagement", "project", "hour", "day", "month"] },
        "note": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        {
          "if": { "properties": { "model": { "const": "quote" } } },
          "then": { "properties": { "currency": { "type": "null" }, "amount": { "type": "null" }, "minimum": { "type": "null" }, "maximum": { "type": "null" } } },
          "else": { "properties": { "currency": { "type": "string" } } }
        },
        {
          "if": { "properties": { "model": { "const": "range" } } },
          "then": { "properties": { "amount": { "type": "null" }, "minimum": { "type": "number" }, "maximum": { "type": "number" } } }
        },
        {
          "if": { "properties": { "model": { "enum": ["fixed", "from", "indicative"] } } },
          "then": { "properties": { "amount": { "type": "number" }, "minimum": { "type": "null" }, "maximum": { "type": "null" } } }
        }
      ]
    },
    "offer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "group", "title", "summary", "bestFor", "outcome", "includes", "excludes", "clientInputs", "completion", "journeyIds", "price"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" }, "group": { "$ref": "#/$defs/slug" },
        "title": { "$ref": "#/$defs/text" }, "summary": { "$ref": "#/$defs/text" }, "bestFor": { "$ref": "#/$defs/text" }, "outcome": { "$ref": "#/$defs/text" },
        "includes": { "$ref": "#/$defs/texts" }, "excludes": { "$ref": "#/$defs/texts" }, "clientInputs": { "$ref": "#/$defs/texts" }, "completion": { "$ref": "#/$defs/text" },
        "journeyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } },
        "price": { "$ref": "#/$defs/price" }
      }
    }
  }
}
